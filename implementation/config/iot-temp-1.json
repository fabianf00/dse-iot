{
  "serviceId": "iot-temp-1",
  "sensor": {
    "dataType": "temperature",
    "unit": "CELSIUS",
    "publishIntervalMs": 1000,
    "generator": {
      "kind": "SINE",
      "base": 23.0,
      "amplitude": 2.0,
      "periodSeconds": 600,
      "phaseSeconds": 0,
      "noiseStdDev": 0.2,
      "seed": 101,
      "min": -20.0,
      "max": 50.0
    },
    "anomalyInjection": {
      "enabled": true,
      "probabilityPerReading": 0.0015,
      "offset": -12.0,
      "durationSeconds": 60
    }
  },
  "cf": {
    "listenPort": 50101,
    "scan": {
      "hosts": [
        "127.0.0.1"
      ],
      "portRange": {
        "from": 50100,
        "to": 50129
      }
    }
  }
}
